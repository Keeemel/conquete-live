# Copie ce fichier en "config.env" (meme dossier), enleve le # devant les lignes que tu veux utiliser.
# ATTENTION : config.env contient tes cles secretes. Ne le partage jamais et ne l'affiche pas a l'ecran.

# --- Animateur IA ---
# HOST=off                  # coupe completement l'animateur
# HOST_NAME=Max             # prenom de l'animateur (utilise par l'IA pour ecrire les phrases)
# HOST_LANG=fr              # fr ou en

# --- Voix ---
# Edge-TTS ne demande aucun compte ni cle API.
# Change cette valeur pour choisir une autre voix Edge-TTS.
EDGE_TTS_VOICE=fr-FR-HenriNeural
# EDGE_TTS_RATE=+3%

# --- Phrases ecrites par Claude (recap, fin de manche, gros cadeaux). Sinon : phrases integrees. ---
# ANTHROPIC_API_KEY=ta_cle
# HOST_LLM_MODEL=claude-haiku-5-5

# --- Connexion directe TikTok (sans TikFinity) ---
# EULER_KEY=ta_cle
